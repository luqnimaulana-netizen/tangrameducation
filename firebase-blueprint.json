{
  "entities": {
    "Reflection": {
      "title": "Reflection",
      "description": "Student learning reflection entry for Bangun Datar Adventure.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique reflection identifier",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "description": "Full name of the Grade 4 student",
          "minLength": 2,
          "maxLength": 100
        },
        "studentClass": {
          "type": "string",
          "description": "Class name of the Grade 4 student (e.g. IV-A, 4B)",
          "minLength": 1,
          "maxLength": 32
        },
        "feeling": {
          "type": "string",
          "description": "Selected learning feeling expression",
          "enum": ["seru", "bosan"]
        },
        "message": {
          "type": "string",
          "description": "Optional student message and impression",
          "minLength": 0,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp string of submission",
          "minLength": 10,
          "maxLength": 40
        },
        "createdAtTimestamp": {
          "type": "number",
          "description": "Epoch milliseconds of submission"
        },
        "serverCreatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Firestore serverTimestamp of creation"
        },
        "source": {
          "type": "string",
          "description": "Application source and version identifier",
          "enum": ["bangun-datar-adventure-v2"]
        },
        "syncStatus": {
          "type": "string",
          "description": "Synchronization status with Google Sheets",
          "enum": ["synced", "pending", "failed"]
        },
        "sheetSyncedAt": {
          "type": "string",
          "description": "ISO 8601 timestamp when synced to Google Sheets",
          "minLength": 0,
          "maxLength": 40
        },
        "lastSyncError": {
          "type": "string",
          "description": "Last synchronization error message if failed",
          "minLength": 0,
          "maxLength": 300
        }
      },
      "required": [
        "id",
        "studentName",
        "studentClass",
        "feeling",
        "message",
        "createdAt",
        "createdAtTimestamp",
        "serverCreatedAt",
        "source",
        "syncStatus"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized teacher/admin record in allowlist.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Teacher email address",
          "minLength": 5,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "description": "Role identifier",
          "enum": ["admin", "teacher"]
        }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/reflections/{reflectionId}": {
      "schema": {
        "$ref": "#/entities/Reflection"
      },
      "description": "Stores student reflections submitted from the Reflection page and read by authorized teachers in the Teacher Dashboard."
    },
    "/admins/{adminUid}": {
      "schema": {
        "$ref": "#/entities/AdminUser"
      },
      "description": "Stores allowlisted teacher/admin UIDs provisioned by the project owner."
    }
  }
}
