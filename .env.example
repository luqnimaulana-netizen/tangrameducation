# ============================================================================
# BANGUN DATAR ADVENTURE — KOMPOSISI BANGUN DATAR KELAS IV SD
# Template Environment Variables (.env.example)
# ============================================================================

# 1. Konfigurasi Firebase Web SDK (Frontend Vite)
# Jika tidak diisi di .env, aplikasi otomatis menggunakan konfigurasi bawaan
# pada firebase-applet-config.json yang sudah diprovisikan.
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="nama-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="nama-project"
VITE_FIREBASE_STORAGE_BUCKET="nama-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"
VITE_FIRESTORE_DATABASE_ID="(default)"

# 2. Tautan Google Spreadsheet untuk Tombol "Buka Google Sheets" di Dashboard Guru
VITE_GOOGLE_SHEETS_SPREADSHEET_URL="https://docs.google.com/spreadsheets/d/ID_SPREADSHEET_ANDA/edit"

# 3. Konfigurasi Serverless Function Netlify untuk Sinkronisasi Google Sheets
# Masukkan variabel ini di Netlify Dashboard -> Site Configuration -> Environment Variables
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/ID_DEPLOYMENT_APPS_SCRIPT/exec"
GOOGLE_SHEETS_WEBHOOK_SECRET="RAHASIA_TOKEN_SINKRONISASI_GURU"

# 4. Variabel Runtime AI Studio (Otomatis)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
